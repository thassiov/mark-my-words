{
  "name": "mark-my-words",
  "version": "0.0.0",
  "private": true,
  "description": "Personal browser tool to save text selections from any web page locally.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build",
    "build:reload": "vite build && pnpm reload",
    "reload": "node scripts/reload-extension.mjs",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:build": "vite build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "knip": "knip",
    "deps:circular": "madge --circular --extensions ts,tsx src",
    "deps:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "type-coverage": "type-coverage --strict --at-least 99",
    "audit": "pnpm audit --prod --audit-level high",
    "static": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm deps:circular && pnpm deps:boundaries && pnpm type-coverage",
    "verify": "pnpm static && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.33",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.4",
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "knip": "^6.12.0",
    "madge": "^8.0.0",
    "preact": "^10.29.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "dexie": "^4.4.2",
    "ulid": "^3.0.2"
  }
}
